# Mẫu cho file .env (file .env thật KHÔNG được đưa lên Git: đã có trong .gitignore).
# Tạo .env với mật khẩu ngẫu nhiên:  node scripts/init-env.js
# Tự điền tay thì: mỗi giá trị là một chuỗi ngẫu nhiên dài, không dấu cách, không ký tự "#" hoặc "$".

# Mật khẩu của PostgreSQL nội bộ (container wf-postgres, user/db "workforce").
# Chỉ đặt MỘT LẦN trước lần chạy đầu tiên: đổi sau đó thì database cũ sẽ không đăng nhập được.
WF_POSTGRES_PASSWORD=change-me-to-a-long-random-password

# Khoá bảo vệ các webhook của n8n (header X-API-Key). Dashboard tự gửi khoá này, trình duyệt không thấy.
WORKFORCE_API_KEY=change-me-to-a-long-random-key
